# ============================================================
# gem5-Balar local installation configuration
#
# Copy this file to:
#
#     configs/local.env
#
# and adapt the paths to your installation.
# ============================================================

# Main workspaces
BALAR_WORK=/path/to/gem5-balar
GEM5_INFRA_DIR=/path/to/gem5-infra

GEM5_DIR="${BALAR_WORK}/gem5"
GPGPUSIM_ROOT="${BALAR_WORK}/gpgpu-sim"
SST_ELEMENTS_DIR="${BALAR_WORK}/sst-elements"

# Optional Python dependency directory
PYDEPS_DIR="${BALAR_WORK}/pydeps"

# ------------------------------------------------------------
# GPGPU-Sim
# ------------------------------------------------------------

# Optional.
# If empty, setup_env.sh searches for libcudart.so automatically
# inside ${GPGPUSIM_ROOT}/lib.
GPGPUSIM_LIBDIR=

# CUDA toolkit used by GPGPU-Sim for PTX extraction.
CUDA_INSTALL_PATH=/path/to/cuda

# ------------------------------------------------------------
# gem5
# ------------------------------------------------------------

GEM5_BIN="${GEM5_DIR}/build/BSC/gem5.opt"
GEM5_SCRIPT="${GEM5_INFRA_DIR}/gem5/simulate.py"

# Architecture configuration used by gem5-infra.
BENCH_CONFIG=/path/to/system-config.yaml

# ------------------------------------------------------------
# Full-system resources
# ------------------------------------------------------------

KERNEL=/path/to/riscv-vmlinux
ROOTDISK=/path/to/gem5-ubuntu-riscv64.img
BENCHDISK=/path/to/benchmarks-balar.img
CHECKPOINT_DIR=/path/to/linux-balar-base


# Generated benchmark scripts/results.
GENERATED_DIR="${BALAR_WORK}/generated/vecadd"

# ------------------------------------------------------------
# Optional cluster-specific configuration
# ------------------------------------------------------------

# Example on BSC:
# PYTHON_MODULE=miniforge/24.11.3-2
PYTHON_MODULE=

# ------------------------------------------------------------
# gem5-infra result parser
# ------------------------------------------------------------

# Optional Python interpreter used by gem5-infra after the simulation.
#
# Leave empty to autodetect python3.
#
# Example BSC environment:
# GEM5INFRA_PARSER_PYTHON="${BALAR_WORK}/env-gem5infra/bin/python"
GEM5INFRA_PARSER_PYTHON=

# Slurm submission settings.
# Adjust these for the target HPC system.
SLURM_ACCOUNT=bsc18
SLURM_QOS=ngp_debug

# Memory requested for the vecadd Slurm job.
SLURM_MEM=8G
