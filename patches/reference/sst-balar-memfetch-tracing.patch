+
+void
+BalarMMIO::send_read_request_SST(
+    unsigned core_id,
+    uint64_t address,
+    uint64_t size,
+    void* mem_req)
+{
+    assert(numPendingCacheTransPerCore[core_id] < maxPendingCacheTrans);
+
+    StandardMem::Read* req =
+        new Interfaces::StandardMem::Read(address, size);
+
+    req->vAddr = address;
 
+    cache_req_params crp(
+        core_id,
+        mem_req,
+        req,
+        gpuClockCycle,
+        address,
+        size,
+        false
+    );
+
+    gpuCachePendingTransactions->insert(
+        std::pair<
+            StandardMem::Request::id_t,
+            cache_req_params
+        >(req->getID(), crp)
+    );
+
+    numPendingCacheTransPerCore[core_id]++;
+    ++gpuMemTraceIssued;
+
+    if (gpuMemTraceIssued <= 64 ||
+        (gpuMemTraceIssued % 10000ULL) == 0) {
+
+        out.output(
+            "[SST-BALAR-MEM] ISSUE #%llu "
+            "req=%llu cycle=%llu core=%u "
+            "op=READ addr=0x%llx size=%llu "
+            "outstanding=%u\n",
+            (unsigned long long)gpuMemTraceIssued,
+            (unsigned long long)req->getID(),
+            (unsigned long long)gpuClockCycle,
+            core_id,
+            (unsigned long long)address,
+            (unsigned long long)size,
+            numPendingCacheTransPerCore[core_id]
+        );
+    }
+
+    gpu_to_cache_links[core_id]->send(req);
+}
